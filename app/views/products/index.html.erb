<% selected_currency = session[:currency] || "usd" %>
<div class="content-sticky">
  <div class="store-logo-and-currency">
    <%= image_tag "logobash.png", alt: "Logo", class: "store-logo" %>

    <details class="menu-dropdown">
      <summary>
        <%= selected_currency == "bs" ? "BS" : "USD" %> <span>⌄</span>
      </summary>

      <div class="dropdown-options">
        <button type="button" onclick="setCurrency('usd')">
          USD
        </button>

        <button type="button" onclick="setCurrency('bs')">
          BS
        </button>
      </div>
    </details>
  </div>

  <div class="product-search">
    <%= form_with url: products_path,
        method: :get,
        local: true,
        id: "product-search-form" do |form| %>

      <div class="search-wrapper">
        <i class="ph ph-magnifying-glass search-icon"></i>

        <%= form.search_field :q,
            value: params[:q],
            placeholder: "Buscar productos...",
            class: "search-input",
            id: "product-search-input",
            autocomplete: "off" %>
      </div>

      <%= hidden_field_tag :category_id, params[:category_id] if params[:category_id].present? %>
      <%= hidden_field_tag :sale_type, params[:sale_type] if params[:sale_type].present? %>
    <% end %>
  </div>
  <div class="flex-category">
    <ul class="admin-categories-list">
      <li class="<%= 'active-filter' if params[:category_id].blank? && params[:sale_type].blank? %>">
        <%= link_to "Todos", products_path, class: "category-link" %>
      </li>

      <% Category.all.each do |category| %>
        <li class="<%= 'active-filter' if params[:category_id].to_i == category.id %>">
          <%= link_to category.name,
              products_path(category_id: category.id),
              class: "category-link" %>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<% setting = Setting.current %>
<header>
  <div id="slider">
    <% [
      ["banner_1", setting.banner_1],
      ["banner_2", setting.banner_2],
      ["banner_3", setting.banner_3]
    ].each do |name, image| %>

      <% if image.attached? %>
        <div class="slide">
          <%= image_tag image, alt: "Imagen destacada #{name}" %>
        </div>
      <% end %>
    <% end %>
  </div>
</header>


  <a href="/"><h1>Los más destacados</h1></a>

  <div class="products-grid">
    <% if @products.empty? %>
      <p>No se encontraron productos.</p>
      <% else %>
      <% @products.each do |product| %>

        <div class="product-card product"
          data-usd="<%= product.price_usd %>"
          data-bs="<%= product.price_bs %>">

          <% product_images = product.slider_images.to_a %>

          <% if product_images.empty? && product.image.attached? %>
            <% product_images = [product.image] %>
          <% end %>

          <div class="product-gallery">
            <% product_images.each do |image| %>
              <div class="product-gallery__slide">
                <%= image_tag image,
                    alt: product.name,
                    class: "product-gallery__image" %>
              </div>
            <% end %>
          </div>

          <h3><%= product.name %></h3>
          <p><%= product.description %></p>
          <% currency = session[:currency] || "usd" %>
          <div class="line-price"> 
            <p class="price">
              <%= currency == "usd" ?
              "$#{number_with_delimiter(product.price_usd, delimiter: ',')}" :
              "Bs #{number_with_delimiter(product.price_bs, delimiter: ',')}" %>
            </p>

            <% if product.quantity > 0 %>

            <%= button_to add_to_cart_path(product.id),
                method: :post,
                form: { data: { turbo_stream: true } },
                class: "add-cart-button" do %>
              <i class="ph ph-shopping-cart"></i>
              <span>Agregar</span>
            <% end %>

            <% else %>

            <p class="out-of-stock">Agotado</p>

            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<div id="floating-cart" onclick="openCartSidebar()">
  <i class="ph ph-shopping-cart"></i>
  <span id="cart-count"><%= CartItem.where(session_id: current_Session).sum(:quantity) %></span>
</div>
<div id="cart-sidebar">
  <div class="cart-header">
    <div>
      <i class="ph-light ph-handbag"></i>
      <h2>Tu Carrito</h2>
    </div>
    <button onclick="closeCartSidebar()" class="close-btn">×</button>
  </div>

  <div id="cart-sidebar-content">
    <div id="cart-items">
      <%= render "cart/cart_items" %>
    </div>
  </div>
</div>

<section class="fashion-quote">
  <%= image_tag "fashion-woman.jpg",
      alt: "Mujer vistiendo con elegancia",
      class: "fashion-quote__image" %>

  <div class="fashion-quote__overlay"></div>

  <div class="fashion-quote__content">
    <p class="fashion-quote__title">
      “Vístete con elegancia y autenticidad cada día.”
    </p>

    <p class="fashion-quote__description">
      Inspirada en la poesía visual de las mujeres que dejan huella con su simple presencia.
    </p>
  </div>
</section>

<section class="bah-experience">
  <h2>La Experiencia Bah's</h2>

  <p class="bah-experience__intro">
    Cuidamos cada detalle desde nuestro taller hasta tu hogar.
  </p>

  <div class="bah-experience__items">
    <div class="bah-experience__item">
      <div class="bah-experience__icon bah-experience__icon--pink">
        <i class="ph ph-truck"></i>
      </div>

      <div>
        <h3>Envíos Express</h3>
        <p>Entregas cuidadas en todo el país</p>
      </div>
    </div>

    <div class="bah-experience__item">
      <div class="bah-experience__icon bah-experience__icon--pink">
        <i class="ph ph-scissors"></i>
      </div>

      <div>
        <h3>Prendas Exclusivas</h3>
        <p>Alta confección en tiradas limitadas</p>
      </div>
    </div>

    <div class="bah-experience__item bah-experience__item--support">
      <div class="bah-experience__icon bah-experience__icon--beige">
        <i class="ph ph-notepad"></i>
      </div>

      <div class="bah-experience__text">
        <h3>Atención<br>Personalizada</h3>
        <p>Asesoría de estilo vía WhatsApp</p>
      </div>

      <a
        href="https://wa.me/584122154020?text=Hola%2C%20te%20escribo%20desde%20tu%20tienda.%20Quiero%20m%C3%A1s%20asesor%C3%ADa%20en%20la%20moda."
        target="_blank"
        rel="noopener"
        class="bah-experience__button">
        Escribir
      </a>
    </div>
  </div>
</section>
<footer class="site-footer">
  <%= image_tag "logobash.png", alt: "Glowtech Electronics", class: "footer-logo" %>
    <p class="social-title">Social Shop</p>
  <div class="social-links">

    <div class="social-icons">
      <a href="https://www.instagram.com/bahsfashion?stkn=eHl1a2s1MXFlMGRi" target="_blank" rel="noopener" class="instagram-link">
        <%= image_tag "instagram.png", alt: "Instagram" %>
      </a>

      <a href="https://www.tiktok.com/@bahsfashion.ve?_r=1&_t=ZN-99x9ZXk2nQM" target="_blank" rel="noopener" class="tiktok-link">
        <%= image_tag "tiktok.png", alt: "TikTok" %>
      </a>
    </div>
  </div>
  <div>
    <p class="social-title">
      Desarrollado por
      <a href="https://luissanteliz.netlify.app" target="_blank" rel="noopener">
        Louis Santeliz
      </a>
    </p>

    <p class="copyright">
      © 2026 Bash Fashion. Todos los derechos reservados.
    </p>
  </div>
</footer>

<script>
  (() => {
    window.openCartSidebar = function () {
      document.getElementById("cart-sidebar").classList.add("open");
      document.getElementById("floating-cart").classList.add("hidden");
    };

    window.closeCartSidebar = function () {
      document.getElementById("cart-sidebar").classList.remove("open");
      document.getElementById("floating-cart").classList.remove("hidden");
    };

    if (window.sliderInterval) {
      clearInterval(window.sliderInterval);
    }

    const slider = document.getElementById("slider");

    if (slider) {
      const slides = slider.children.length;

      if (slides > 1) {
        let currentPosition = 0;
        let startX = 0;
        let startY = 0;
        let currentX = 0;
        let isDragging = false;

        function updateSlider(animate = true) {
          slider.style.transition = animate
            ? "transform 0.7s ease-in-out"
            : "none";

          slider.style.transform =
            `translateX(${-100 * currentPosition / slides}%)`;
        }

        function startAutoSlide() {
          clearInterval(window.sliderInterval);

          window.sliderInterval = setInterval(() => {
            currentPosition = (currentPosition + 1) % slides;
            updateSlider();
          }, 5000);
        }

        slider.addEventListener("pointerdown", (event) => {
          isDragging = true;
          startX = event.clientX;
          startY = event.clientY;
          currentX = startX;

          slider.style.cursor = "grabbing";
          slider.style.transition = "none";
        });

        slider.addEventListener("pointermove", (event) => {
          if (!isDragging) return;

          const deltaX = event.clientX - startX;
          const deltaY = event.clientY - startY;

          // Si el gesto es vertical, dejamos que la página haga scroll
          if (Math.abs(deltaY) > Math.abs(deltaX)) {
            isDragging = false;
            slider.style.cursor = "grab";
            slider.style.transition = "transform 0.7s ease-in-out";
            return;
          }

          currentX = event.clientX;
          const distance = currentX - startX;
          const movement = (distance / slider.clientWidth) * 100;

          slider.style.transform =
            `translateX(calc(${-100 * currentPosition / slides}% + ${movement}px))`;
        });

        function finishSwipe(event) {
          if (!isDragging) return;

          isDragging = false;
          slider.style.cursor = "grab";

          const distance = currentX - startX;
          const minimumSwipeDistance = 50;

          if (Math.abs(distance) >= minimumSwipeDistance) {
            if (distance < 0) {
              currentPosition = (currentPosition + 1) % slides;
            } else {
              currentPosition = (currentPosition - 1 + slides) % slides;
            }
          }

          updateSlider();
          startAutoSlide();
        }

        slider.addEventListener("pointerup", finishSwipe);
        slider.addEventListener("pointercancel", finishSwipe);
        slider.addEventListener("pointerleave", (event) => {
          if (isDragging && event.buttons === 1) {
            finishSwipe(event);
          }
        });

        updateSlider(false);
        startAutoSlide();
      }
    }
  })();

  (() => {
    const galleries = document.querySelectorAll(".product-gallery");

    galleries.forEach((gallery) => {
      let isDragging = false;
      let startX = 0;
      let startScrollLeft = 0;

      gallery.addEventListener("pointerdown", (event) => {
        isDragging = true;
        startX = event.clientX;
        startScrollLeft = gallery.scrollLeft;
        gallery.setPointerCapture(event.pointerId);
      });

      gallery.addEventListener("pointermove", (event) => {
        if (!isDragging) return;

        const deltaX = event.clientX - startX;
        gallery.scrollLeft = startScrollLeft - deltaX;
      });

      const stopDragging = () => {
        if (!isDragging) return;
        isDragging = false;

        const slides = [...gallery.children];
        const index = Math.round(gallery.scrollLeft / gallery.clientWidth);
        const target = slides[index];

        if (target) {
          gallery.scrollTo({
            left: target.offsetLeft,
            behavior: "smooth"
          });
        }
      };

      gallery.addEventListener("pointerup", stopDragging);
      gallery.addEventListener("pointercancel", stopDragging);
      gallery.addEventListener("pointerleave", stopDragging);
    });
  })();
</script>
