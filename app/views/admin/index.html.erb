<a href="/admin"><h1>Panel Admin</h1></a>

<div class="admin-menu">
  <div class="admin-menu__actions">
    <a href="/admin/new">Nuevo Producto</a>
    <a href="/admin/categories">📂 Categorías</a>
    <a href="/admin/slider">🖼 Imágenes del banner</a>
  </div>
</div>

<div class="rate-box">
  <h3>Tasa del día</h3>

  <%= form_with url: update_rate_path, method: :patch, local: true do %>
    <input type="number" step="0.01" name="rate" value="<%= Setting.current.rate %>">
    <button type="submit">Actualizar</button>
  <% end %>
</div>
<div class="flex-category">
  <ul class="admin-categories-list">
    <% Category.all.each do |category| %>
      <li class="<%= 'active-filter' if params[:category_id].to_i == category.id %>">
        <%= link_to category.name,
            admin_path(category_id: category.id, sale_type: params[:sale_type]), class: "category-link" %>
      </li>
    <% end %>
  </ul>
</div>

<div class="products-grid">

  <% @products.each do |product| %>

  <div class="product-card">

    <% primary_image = product.slider_images.first || product.image %>
    <%= image_tag primary_image if primary_image.present? %>

    <h3><%= product.name %></h3>
    <p>Tipo: <%= product.sale_type %></p>

    <p>Stock: <%= product.quantity %></p>

    <p>$<%= number_with_delimiter(product.price_usd, delimiter: ",") %></p>

    <a class="btn-edit" href="/admin/edit/<%= product.id %>">✏️ Editar</a>

    <%= button_to "🗑 Eliminar",
    "/admin/destroy/#{product.id}",
    method: :delete,
    data: { turbo_confirm: "¿Seguro que deseas eliminar este producto?" } %>

  </div>

  <% end %>

</div>