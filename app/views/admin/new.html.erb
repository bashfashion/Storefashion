<h2>Agregar Nuevo Producto</h2>

<%= form_with model: @product, url: "/admin/create", local: true, multipart: true do |f| %>

<div>
<%= f.label :name %>
<%= f.text_field :name %>
</div>

<div>
<%= f.label :description %>
<%= f.text_area :description %>
</div>

<div>
<%= f.label :price_usd %>
<%= f.number_field :price_usd, step: "any" %>
</div>

<div>
<%= f.label :price_bs %>
<%= f.number_field :price_bs, step: "any" %>
</div>

<div>
  <%= f.label :category_id, "Categoría del producto" %>
  <%= f.collection_select :category_id, Category.all, :id, :name, prompt: "Seleccionar categoría" %>
</div>

<div>
<%= f.label :quantity, "Stock disponible" %>
<%= f.number_field :quantity %>
</div>

<div>
  <%= f.label :slider_images, "Imagen principal" %>
  <%= file_field_tag "product[slider_images][]",
      accept: "image/*",
      required: true %>
</div>

<div>
  <%= label_tag "product_slider_image_2", "Imagen 2" %>
  <%= file_field_tag "product[slider_images][]",
      id: "product_slider_image_2",
      accept: "image/*" %>
</div>

<div>
  <%= label_tag "product_slider_image_3", "Imagen 3" %>
  <%= file_field_tag "product[slider_images][]",
      id: "product_slider_image_3",
      accept: "image/*" %>
</div>

<div>
  <%= label_tag "product_slider_image_4", "Imagen 4" %>
  <%= file_field_tag "product[slider_images][]",
      id: "product_slider_image_4",
      accept: "image/*" %>
</div>

<div>
  <%= label_tag "product_slider_image_5", "Imagen 5" %>
  <%= file_field_tag "product[slider_images][]",
      id: "product_slider_image_5",
      accept: "image/*" %>
</div>

<small>
  La primera imagen será la imagen principal. Puedes subir entre 1 y 5 imágenes.
</small>

<%= f.submit "Crear Producto" %>
<%= link_to "Cancel", "/admin" %>

<% end %>
<%= link_to "Volver al inicio", "/admin", class: "back-link" %>
